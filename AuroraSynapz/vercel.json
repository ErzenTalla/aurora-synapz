{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/alpaca/cron-sync",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/admin/fee/cron-collect",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/alpaca/cron-strategy-run",
      "schedule": "15 21 * * 1-5"
    }
  ]
}